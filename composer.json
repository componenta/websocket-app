{
    "name": "componenta/websocket-app",
    "description": "Application integration for Componenta WebSocket server",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/app": "^1.0 || ^2.0 || ^3.0.2",
        "componenta/config": "^2.0.2",
        "componenta/path-resolver": "^1.0",
        "componenta/scope": "^1.0",
        "componenta/websocket-server": "^1.0.2",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\App\\WebSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\App\\WebSocket\\Tests\\": "tests/"
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\App\\WebSocket\\ConfigProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
